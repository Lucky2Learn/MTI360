# =============================================================================
# MTI 360 — root environment template (Docker Compose level)
# =============================================================================
#
# Copy to `.env` for local development:   cp .env.example .env
#
#   * `.env` is ignored by git and must NEVER be committed.
#   * This file contains PLACEHOLDERS ONLY. Never put a real secret here.
#   * Replace every `change-me` value locally with a long random value.
#     Compose REFUSES TO START while a required secret is missing.
#   * Staging and production values are injected by the secret manager / CI,
#     never from committed files.
#
# Consumed by the root `compose.yaml` (T00-03) for LOCAL development only.
# Application settings live in backend/.env.example and frontend/.env.example;
# they are validated per APP_ENV by the applications (T00-04,
# docs/architecture/environments.md). The `api` container receives APP_ENV,
# LOG_LEVEL and container-network database URLs for the app and read-only roles
# built from the passwords below; only the one-shot `migrate` container also
# receives the owner URL (T01-01). Use URL-safe random values (for example hex).
#
# The Compose project name is fixed to "mti360" inside compose.yaml. Do NOT set
# COMPOSE_PROJECT_NAME: it would override that name and could make Compose
# commands act on another local project (for example ACRS).
#
# All published ports bind to 127.0.0.1. The defaults avoid the ports other
# local projects commonly use (3000, 8000, 5432, ...). Change one only if
# `pnpm ports:check` reports a conflict, and update backend/.env (and
# frontend/.env.local, if present) to match. No object-storage console port is
# published: the SeaweedFS admin UI is disabled.
# =============================================================================

# Runtime environment: development | test | staging | production
APP_ENV=development

# --- PostgreSQL 18 (local container) --------------------------------------------
# Database created on first start (empty volume)
POSTGRES_DB=mti360
# Bootstrap superuser of the LOCAL container only. The application never uses
# it; database/init/01-roles.sh creates the roles below on first start.
POSTGRES_USER=mti360_superuser
POSTGRES_PASSWORD=change-me
# Owner of the database and schema; future migrations run as this role.
MTI_OWNER_PASSWORD=change-me
# Application runtime role (DML only, no BYPASSRLS). Must match backend/.env.
MTI_APP_PASSWORD=change-me
# Read-only role (SELECT only) for reporting / governed SQL agent.
MTI_READONLY_PASSWORD=change-me
# Host port (127.0.0.1 only). Default 15432.
POSTGRES_PORT=15432

# --- Redis 8.8 (local container) --------------------------------------------------
# Host port (127.0.0.1 only). Default 16379.
REDIS_PORT=16379

# --- S3-compatible object storage — SeaweedFS 4.47 (local container) -------------
# Host endpoint for native development: http://127.0.0.1:${S3_PORT}
# (inside the Compose network: http://object-storage:8333)
# Access key / secret of the LOCAL emulator's S3 admin identity. Anonymous
# access is denied. Must match backend/.env S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY.
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
# Private bucket created by the one-shot object-storage-init service.
S3_BUCKET=mti360-local
# Host port (127.0.0.1 only). Default 18333.
S3_PORT=18333

# --- Mailpit 1.31 (local SMTP catcher) ---------------------------------------------
# SMTP host port (127.0.0.1 only). Default 11025.
MAILPIT_SMTP_PORT=11025
# Web UI host port (127.0.0.1 only). Default 18025: http://127.0.0.1:18025
MAILPIT_UI_PORT=18025

# --- Application ports ----------------------------------------------------------------
# Used by the `app` Compose profile (pnpm stack:up). The native dev servers
# (pnpm dev) read the same names from the SHELL environment only (default
# 3100 / 8100), e.g.  FRONTEND_PORT=3200 API_PORT=8200 pnpm dev
# FastAPI backend. Default 8100.
API_PORT=8100
# Next.js frontend. Default 3100.
FRONTEND_PORT=3100
