# =============================================================================
# MTI 360 — root environment template (Docker Compose level)
# =============================================================================
#
# Copy to `.env` for local development:   cp .env.example .env
#
#   * `.env` is ignored by git and must NEVER be committed.
#   * This file contains PLACEHOLDERS ONLY. Never put a real secret here.
#   * Replace every `change-me` value locally.
#   * Staging and production values are injected by the secret manager / CI,
#     never from committed files.
#
# These variables are consumed by the root `compose.yaml` (introduced in T00-03).
# Application settings live in backend/.env.example and frontend/.env.example.
# =============================================================================

# Runtime environment: development | test | staging | production
APP_ENV=development

# Docker Compose project name (prefixes container, network and volume names)
COMPOSE_PROJECT_NAME=mti360

# --- PostgreSQL (local container) ---------------------------------------------
# Database created on first start
POSTGRES_DB=mti360
# Superuser for the LOCAL container only. The application does not use this
# account; database/init creates separate owner / app / readonly roles.
POSTGRES_USER=mti360_superuser
POSTGRES_PASSWORD=change-me
# Host port bound to 127.0.0.1 only
POSTGRES_PORT=5432

# --- Redis (local container) --------------------------------------------------
REDIS_PORT=6379

# --- S3-compatible object storage emulator (local container) ------------------
# Root credentials of the LOCAL emulator only
OBJECT_STORAGE_ROOT_USER=change-me
OBJECT_STORAGE_ROOT_PASSWORD=change-me
OBJECT_STORAGE_API_PORT=9000
OBJECT_STORAGE_CONSOLE_PORT=9001

# --- Mailpit (local SMTP catcher) ---------------------------------------------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Application ports ----------------------------------------------------------
# FastAPI backend
API_PORT=8000
# Next.js frontend
FRONTEND_PORT=3000
