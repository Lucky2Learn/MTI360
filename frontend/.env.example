# =============================================================================
# MTI 360 — frontend environment template (Next.js)
# =============================================================================
#
# Copy to `frontend/.env.local` for local development:
#     cp frontend/.env.example frontend/.env.local
#
#   * `frontend/.env.local` is ignored by git and must NEVER be committed.
#   * PLACEHOLDERS ONLY.
#
# SECURITY RULE:
#   Any variable prefixed `NEXT_PUBLIC_` is embedded into JavaScript shipped to
#   every browser. It is PUBLIC. Never put a secret, token, API key or internal
#   credential in a NEXT_PUBLIC_ variable. The frontend is designed to hold no
#   secrets at all: provider credentials live only in the backend.
# =============================================================================

# --- Runtime (server-side only) --------------------------------------------------
# development | test | staging | production
APP_ENV=development

# --- Backend API (server-side only) -------------------------------------------------
# Internal URL the Next.js server uses to reach FastAPI (server components and the
# same-origin /api proxy). Not exposed to the browser.
API_BASE_URL=http://localhost:8000

# --- Public values (shipped to the browser) -----------------------------------------
# Display name used in page titles
NEXT_PUBLIC_APP_NAME=MTI 360
