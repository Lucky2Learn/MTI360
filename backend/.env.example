# =============================================================================
# MTI 360 — backend environment template (FastAPI API + worker)
# =============================================================================
#
# Copy to `backend/.env` for local development:
#     cp backend/.env.example backend/.env
#
#   * `backend/.env` is ignored by git and must NEVER be committed.
#   * PLACEHOLDERS ONLY. Never put a real secret, API key or credential here.
#   * In staging/production these values are injected by the secret manager
#     as PROCESS ENVIRONMENT variables. `backend/.env` is read ONLY when
#     APP_ENV=development; test, staging and production never read it, and
#     APP_ENV itself must come from the process environment (T00-04).
#   * Development works with NO `backend/.env` at all: every variable has a
#     local default matching the T00-03 infrastructure (app/core/config.py).
#
# CONSUMED AS OF T00-04: every variable below is typed and validated by
# app/core/config.py (a test and `pnpm check:env` keep this file and the
# Settings fields identical). Database, Redis, S3, session, CORS, SMTP and AI
# values are validated only; their clients arrive with later tasks.
#
# [staging/production] marks variables that must be set explicitly there.
# Staging/production also refuse: APP_DEBUG=true, the `fake` AI provider,
# placeholder or empty secrets, database URLs without TLS (ssl=require or
# stricter) and non-https CORS origins / S3 endpoint; production also refuses
# LOG_LEVEL=DEBUG. Full matrix: docs/architecture/environments.md
# =============================================================================

# --- Runtime --------------------------------------------------------------------
# development | test | staging | production
APP_ENV=development
# Enables debug behaviour. Must be false outside development.
APP_DEBUG=true
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- PostgreSQL -------------------------------------------------------------------
# [staging/production] Application role (DML only, subject to Row-Level Security — ADR-0004).
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://mti_app:change-me@localhost:5432/mti360
# [staging/production] Owner role used ONLY to run migrations. Must be a different user.
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://mti_owner:change-me@localhost:5432/mti360
# [staging/production] Read-only role for reporting and the governed SQL/Data Agent
# (SELECT only, RLS applies). Must be a different user from both roles above.
# Staging/production: append ?ssl=require (or verify-ca / verify-full) to all three.
READONLY_DATABASE_URL=postgresql+asyncpg://mti_readonly:change-me@localhost:5432/mti360

# --- Redis ------------------------------------------------------------------------
# [staging/production] Cache, rate limiting, sessions and job queue
REDIS_URL=redis://localhost:6379/0

# --- Object storage (S3-compatible) ----------------------------------------------
# Local emulator endpoint (SeaweedFS, T00-03; port = S3_PORT in root .env).
# [staging/production] Leave empty to use the provider default; otherwise https://.
S3_ENDPOINT_URL=http://127.0.0.1:8333
S3_REGION=us-east-1
# [staging/production] Private bucket. All object keys are prefixed tenants/{tenant_id}/...
# (ADR-0004). S3_REGION and both S3 keys are [staging/production] too.
S3_BUCKET=mti360-local
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
# Lifetime of presigned download/upload URLs, in seconds (keep short)
S3_PRESIGNED_URL_TTL_SECONDS=300

# --- Sessions and CSRF (ADR-0005) ---------------------------------------------------
# [staging/production] Secret used to derive session, reset and invitation token
# hashes (HMAC-SHA256). Outside development: at least 32 characters (test uses
# fixed explicit values).
SESSION_SECRET=change-me
# [staging/production] Secret used for CSRF tokens. Must differ from SESSION_SECRET.
CSRF_SECRET=change-me
# Idle and absolute session lifetimes for tenant and student realms, in minutes
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_MINUTES=720
# Platform realm sessions are shorter (privileged)
PLATFORM_SESSION_IDLE_TIMEOUT_MINUTES=15
PLATFORM_SESSION_ABSOLUTE_TIMEOUT_MINUTES=240

# --- Encryption of recoverable secrets (ADR-0012, T01-06) ----------------------------
# [test/staging/production] AES-256-GCM key for TOTP secrets: base64 of 32 random
# bytes (e.g. `python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"`).
# Development falls back to a public development-only key while this is a placeholder.
DATA_ENCRYPTION_KEY=change-me
# Identifier stored with each ciphertext (letters, digits, - and _; at most 32).
DATA_ENCRYPTION_KEY_ID=k1
# Decrypt-only keys kept after a rotation: id:base64,id:base64 (empty = none).
DATA_ENCRYPTION_RETIRED_KEYS=
# [staging/production] Browser origins allowed to call the API (comma-separated).
# Never "*"; https:// only in staging/production. Also the allow-list for the
# Origin check on anonymous sign-in, reset and invitation requests.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# [staging/production] Frontend origin used in password-reset and invitation links
# (https:// only in staging/production; no path).
APP_BASE_URL=http://localhost:3000
# Number of proxies in front of the API whose X-Forwarded-For entries are trusted
# for the client IP (rate limits, session records). 0 = ignore the header.
TRUSTED_PROXY_HOPS=0

# --- Password hashing (Argon2id; ADR-0010) ------------------------------------------
# argon2-cffi defaults. Raising them upgrades existing hashes at the next sign-in.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4

# --- Email (local: Mailpit) ---------------------------------------------------------
# [staging/production] every SMTP_* variable and EMAIL_FROM_ADDRESS.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=no-reply@mti360.local
# Upper bound for one SMTP delivery, in seconds
SMTP_TIMEOUT_SECONDS=10

# --- AI provider (ADR-0001; CLAUDE.md §46) ------------------------------------------
# [staging/production] `fake` = deterministic provider for development and tests
# (no external calls); it is refused in staging/production.
AI_PROVIDER=fake
# [staging/production] Provider API key. Empty for the fake provider. Never commit a real key.
AI_PROVIDER_API_KEY=
