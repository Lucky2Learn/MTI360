# =============================================================================
# MTI 360 — backend environment template (FastAPI API + worker)
# =============================================================================
#
# Copy to `backend/.env` for local development:
#     cp backend/.env.example backend/.env
#
#   * `backend/.env` is ignored by git and must NEVER be committed.
#   * PLACEHOLDERS ONLY. Never put a real secret, API key or credential here.
#   * In staging/production these values are injected by the secret manager.
#     Production settings validation (T00-04) must refuse to start when a
#     placeholder value such as `change-me` is present.
#
# CONSUMED AS OF T00-02: APP_ENV, APP_DEBUG, LOG_LEVEL (app/core/config.py).
# All other variables below are RESERVED for later tasks (T00-03 local
# services, T00-04 environment configuration, Phase 01 identity/tenancy) and
# are ignored by the application until then.
# =============================================================================

# --- Runtime --------------------------------------------------------------------
# development | test | staging | production
APP_ENV=development
# Enables debug behaviour. Must be false outside development.
APP_DEBUG=true
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- PostgreSQL -------------------------------------------------------------------
# Application role (DML only, subject to Row-Level Security — see ADR-0004).
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://mti_app:change-me@localhost:5432/mti360
# Owner role used ONLY to run Alembic migrations.
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://mti_owner:change-me@localhost:5432/mti360
# Read-only role for reporting and the governed SQL/Data Agent (SELECT only, RLS applies).
READONLY_DATABASE_URL=postgresql+asyncpg://mti_readonly:change-me@localhost:5432/mti360

# --- Redis ------------------------------------------------------------------------
# Cache, rate limiting, sessions and job queue
REDIS_URL=redis://localhost:6379/0

# --- Object storage (S3-compatible) ----------------------------------------------
# Local emulator endpoint. Leave empty in cloud environments using the provider default.
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
# Private bucket. All object keys are prefixed tenants/{tenant_id}/... (ADR-0004).
S3_BUCKET=mti360-local
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
# Lifetime of presigned download/upload URLs, in seconds (keep short)
S3_PRESIGNED_URL_TTL_SECONDS=300

# --- Sessions and CSRF (ADR-0005) ---------------------------------------------------
# Secret used to sign/derive session identifiers. Generate a long random value locally.
SESSION_SECRET=change-me
# Secret used for CSRF tokens. Must differ from SESSION_SECRET.
CSRF_SECRET=change-me
# Idle and absolute session lifetimes for tenant and student realms, in minutes
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_MINUTES=720
# Platform realm sessions are shorter (privileged)
PLATFORM_SESSION_IDLE_TIMEOUT_MINUTES=15
PLATFORM_SESSION_ABSOLUTE_TIMEOUT_MINUTES=240
# Browser origins allowed to call the API (comma-separated). Never "*".
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Email (local: Mailpit) ---------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=no-reply@mti360.local

# --- AI provider (ADR-0001; CLAUDE.md §46) ------------------------------------------
# `fake` = deterministic provider for development and tests. No external calls.
AI_PROVIDER=fake
# Provider API key. Empty for the fake provider. Never commit a real key.
AI_PROVIDER_API_KEY=
